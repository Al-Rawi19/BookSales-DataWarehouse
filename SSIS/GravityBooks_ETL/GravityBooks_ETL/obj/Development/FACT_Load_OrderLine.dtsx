                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    ol.line_id              AS Line_ID,
    ol.order_id             AS Order_ID,
    ol.book_id              AS Book_ID_BK,
    ol.price                AS Unit_Price,
    1                       AS Quantity,
    o.order_date            AS Order_Date,
    o.customer_id           AS Customer_ID_BK,
    o.shipping_method_id    AS Method_ID_BK,
    o.dest_address_id       AS Address_ID_BK
FROM       dbo.STG_order_line   ol
INNER JOIN dbo.STG_cust_order   o  ON ol.order_id = o.order_id
WHERE o.order_id &gt; 0;</property>
