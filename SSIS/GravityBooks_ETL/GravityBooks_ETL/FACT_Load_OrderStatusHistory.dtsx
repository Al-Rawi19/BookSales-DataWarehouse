                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    o.order_id        AS Order_ID,
    o.customer_id     AS Customer_ID_BK,
    o.dest_address_id AS Address_ID_BK,
    o.order_date      AS Order_Date,
    oh.status_id      AS Status_ID_BK
FROM dbo.STG_Cust_Order o
INNER JOIN dbo.STG_Order_History oh
    ON o.order_id = oh.order_id
    AND oh.status_date = (
        SELECT MAX(status_date)
        FROM dbo.STG_Order_History
        WHERE order_id = o.order_id
    )
WHERE o.order_id NOT IN (
    SELECT Order_ID
    FROM [gravity_dwh].[dbo].[Fact_Order_Status_History]
);</property>
