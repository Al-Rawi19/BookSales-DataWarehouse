    <DTS:Executable
      DTS:refId="Package\Update Milestone Dates"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BF544D9A-8E6E-4425-A0C7-B3515519F844}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update Milestone Dates"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DF22934-CC58-4951-8524-3A76CBB07494}"
          SQLTask:SqlStatementSource="UPDATE f&#xA;SET&#xA;    f.Processing_Date_SK = COALESCE(f.Processing_Date_SK,&#xA;        (SELECT TOP 1 CAST(CONVERT(VARCHAR, oh.status_date, 112) AS INT)&#xA;         FROM [Gravity_Books_Staging].[dbo].[STG_Order_History] oh&#xA;         JOIN [Gravity_Books_Staging].[dbo].[STG_Order_Status]  os ON oh.status_id = os.status_id&#xA;         WHERE oh.order_id     = f.Order_ID&#xA;         AND   os.status_value = 'Processing'&#xA;         ORDER BY oh.status_date ASC)),&#xA;&#xA;    f.Shipped_Date_SK = COALESCE(f.Shipped_Date_SK,&#xA;        (SELECT TOP 1 CAST(CONVERT(VARCHAR, oh.status_date, 112) AS INT)&#xA;         FROM [Gravity_Books_Staging].[dbo].[STG_Order_History] oh&#xA;         JOIN [Gravity_Books_Staging].[dbo].[STG_Order_Status]  os ON oh.status_id = os.status_id&#xA;         WHERE oh.order_id     = f.Order_ID&#xA;         AND   os.status_value = 'Shipped'&#xA;         ORDER BY oh.status_date ASC)),&#xA;&#xA;    f.Delivered_Date_SK = COALESCE(f.Delivered_Date_SK,&#xA;        (SELECT TOP 1 CAST(CONVERT(VARCHAR, oh.status_date, 112) AS INT)&#xA;         FROM [Gravity_Books_Staging].[dbo].[STG_Order_History] oh&#xA;         JOIN [Gravity_Books_Staging].[dbo].[STG_Order_Status]  os ON oh.status_id = os.status_id&#xA;         WHERE oh.order_id     = f.Order_ID&#xA;         AND   os.status_value = 'Delivered'&#xA;         ORDER BY oh.status_date ASC)),&#xA;&#xA;    f.Cancelled_Date_SK = COALESCE(f.Cancelled_Date_SK,&#xA;        (SELECT TOP 1 CAST(CONVERT(VARCHAR, oh.status_date, 112) AS INT)&#xA;         FROM [Gravity_Books_Staging].[dbo].[STG_Order_History] oh&#xA;         JOIN [Gravity_Books_Staging].[dbo].[STG_Order_Status]  os ON oh.status_id = os.status_id&#xA;         WHERE oh.order_id     = f.Order_ID&#xA;         AND   os.status_value = 'Cancelled'&#xA;         ORDER BY oh.status_date ASC)),&#xA;&#xA;    f.Days_To_Ship = DATEDIFF(DAY,&#xA;        (SELECT Full_Date FROM dbo.Dim_Date WHERE Date_SK = f.Order_Placed_Date_SK),&#xA;        (SELECT Full_Date FROM dbo.Dim_Date WHERE Date_SK = f.Shipped_Date_SK)),&#xA;&#xA;    f.Days_To_Deliver = DATEDIFF(DAY,&#xA;        (SELECT Full_Date FROM dbo.Dim_Date WHERE Date_SK = f.Shipped_Date_SK),&#xA;        (SELECT Full_Date FROM dbo.Dim_Date WHERE Date_SK = f.Delivered_Date_SK))&#xA;&#xA;FROM dbo.Fact_Order_Status_History f;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
